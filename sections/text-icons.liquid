{% comment %}
  Section : Icônes de caractéristiques produit
  Affichage : 2x2 sur mobile / 4 colonnes sur desktop
{% endcomment %}

<section class="features-icons" id="features-icons-{{ section.id }}">
  <div class="features-icons__container">
    {% for block in section.blocks %}
      {% if block.type == 'feature' %}
        <div class="features-icons__item" {{ block.shopify_attributes }}>
          <div class="features-icons__icon-wrap">
            {% if block.settings.icon != blank %}
              <img
                src="{{ block.settings.icon | img_url: '120x120' }}"
                alt="{{ block.settings.label }}"
                width="80"
                height="80"
                loading="lazy"
              >
            {% else %}
              {{ block.settings.icon | placeholder_svg_tag: 'features-icons__placeholder' }}
            {% endif %}
          </div>
          {% if block.settings.label != blank %}
            <p class="features-icons__label">{{ block.settings.label }}</p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<style>
  #features-icons-{{ section.id }} {
    --icon-size: {{ section.settings.icon_size }}px;
    --label-size: {{ section.settings.label_size }}px;
    --label-color: {{ section.settings.label_color }};
    --bg-color: {{ section.settings.background_color }};
    --columns-desktop: {{ section.settings.columns_desktop }};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .features-icons {
    background-color: var(--bg-color);
    padding: var(--section-padding-top) 20px var(--section-padding-bottom);
    width: 100%;
    box-sizing: border-box;
  }

  .features-icons__container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }

  .features-icons__icon-wrap {
    width: var(--icon-size);
    height: var(--icon-size);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .features-icons__icon-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .features-icons__label {
    font-size: var(--label-size);
    color: var(--label-color);
    font-family: inherit;
    margin: 0;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  @media screen and (min-width: 768px) {
    .features-icons__container {
      grid-template-columns: repeat(var(--columns-desktop), 1fr);
      gap: 30px 40px;
    }
  }

  @media screen and (min-width: 1024px) {
    .features-icons__container {
      gap: 20px 60px;
    }
  }
</style>

{% schema %}
{
  "name": "Icônes produit",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Nombre de colonnes (desktop)"
    },
    {
      "type": "header",
      "content": "Icônes"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 40,
      "max": 140,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "Taille des icônes"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 16,
      "unit": "px",
      "label": "Taille du texte"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Couleur du texte",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Style de la section"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px",
      "label": "Espacement haut"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px",
      "label": "Espacement bas"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Caractéristique",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icône (image SVG ou PNG)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texte",
          "default": "Caractéristique"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icônes produit",
      "blocks": [
        { "type": "feature", "settings": { "label": "Buttery Soft" } },
        { "type": "feature", "settings": { "label": "Includes Postpartum" } },
        { "type": "feature", "settings": { "label": "Ultra Stretch" } },
        { "type": "feature", "settings": { "label": "Breathable Design" } }
      ]
    }
  ]
}
{% endschema %}