{% comment %}
  Section: Video Testimonials / Happimums Style
  Fichier : sections/video-testimonials.liquid
{% endcomment %}

{{ 'video-testimonials.css' | asset_url | stylesheet_tag }}

<section class="vt-section" id="video-testimonials-{{ section.id }}">
  <div class="vt-container">

    {% if section.settings.title != blank %}
      <h2 class="vt-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="vt-slider-wrapper">
      <button class="vt-arrow vt-arrow--prev" aria-label="Précédent">&#8249;</button>

      <div class="vt-track-outer">
        <div class="vt-track" id="vt-track-{{ section.id }}">

          {% for block in section.blocks %}
            {% if block.type == 'video_card' %}
              <div class="vt-card" {{ block.shopify_attributes }}>
                <div class="vt-card__inner">

                  {% if block.settings.label != blank %}
                    <div class="vt-card__label">{{ block.settings.label }}</div>
                  {% endif %}

                  <button class="vt-mute-btn" aria-label="Activer/désactiver le son">
                    <svg class="icon-muted" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="18" height="18">
                      <path d="M16.5 12A4.5 4.5 0 0 0 14 7.97V9.2l2.45 2.45c.03-.21.05-.43.05-.65zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4 9.91 6.09 12 8.18V4z"/>
                    </svg>
                    <svg class="icon-unmuted" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="18" height="18" style="display:none">
                      <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                    </svg>
                  </button>

                  {% if block.settings.video != blank %}
                    <video
                      class="vt-card__video"
                      src="{{ block.settings.video }}"
                      loop
                      muted
                      playsinline
                      preload="metadata"
                    ></video>
                  {% elsif block.settings.image != blank %}
                    <img
                      class="vt-card__image"
                      src="{{ block.settings.image | image_url: width: 400 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="400"
                      height="700"
                    >
                  {% else %}
                    <div class="vt-card__placeholder">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#ccc" width="48" height="48"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                  {% endif %}

                  {% assign rating = block.settings.rating | default: 5 %}
                  <div class="vt-card__footer">
                    <div class="vt-stars" aria-label="{{ rating }} étoiles sur 5">
                      {% for i in (1..5) %}
                        {% if i <= rating %}
                          <span class="vt-star vt-star--full">★</span>
                        {% else %}
                          <span class="vt-star vt-star--empty">★</span>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>

                </div>
              </div>
            {% endif %}
          {% endfor %}

        </div>
      </div>

      <button class="vt-arrow vt-arrow--next" aria-label="Suivant">&#8250;</button>
    </div>

    <div class="vt-dots" id="vt-dots-{{ section.id }}"></div>

  </div>
</section>

<style>
  #video-testimonials-{{ section.id }} {
    --vt-accent: {{ section.settings.accent_color }};
    --vt-title-color: {{ section.settings.title_color }};
    --vt-bg: {{ section.settings.bg_color }};
    --vt-card-radius: {{ section.settings.card_radius }}px;
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }
</style>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const track = document.getElementById('vt-track-' + sectionId);
  const dotsContainer = document.getElementById('vt-dots-' + sectionId);
  const section = document.getElementById('video-testimonials-' + sectionId);
  if (!track) return;

  const cards = Array.from(track.querySelectorAll('.vt-card'));
  const prevBtn = section.querySelector('.vt-arrow--prev');
  const nextBtn = section.querySelector('.vt-arrow--next');

  let currentIndex = 0;
  let autoplayTimer = null;

  function getVisible() {
    const w = window.innerWidth;
    if (w >= 1200) return 5;
    if (w >= 900)  return 3;
    if (w >= 600)  return 2;
    return 1;
  }

  function getCenter() {
    return Math.floor(getVisible() / 2);
  }

  function buildDots() {
    dotsContainer.innerHTML = '';
    cards.forEach((_, i) => {
      const d = document.createElement('button');
      d.className = 'vt-dot';
      d.setAttribute('aria-label', 'Slide ' + (i + 1));
      d.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(d);
    });
  }

  function updateDots() {
    dotsContainer.querySelectorAll('.vt-dot').forEach((d, i) => {
      d.classList.toggle('vt-dot--active', i === currentIndex);
    });
  }

  function updateLayout() {
    const center = getCenter();
    cards.forEach((card, i) => {
      const offset = i - currentIndex;
      const abs = Math.abs(offset);
      card.classList.remove('vt-card--center','vt-card--side','vt-card--far','vt-card--hidden');
      if (offset === 0)        card.classList.add('vt-card--center');
      else if (abs <= center)  card.classList.add('vt-card--side');
      else if (abs <= center + 1) card.classList.add('vt-card--far');
      else                     card.classList.add('vt-card--hidden');

      const gap = 16;
      const cardW = card.offsetWidth || 200;
      card.style.transform = 'translateX(' + (offset * (cardW + gap)) + 'px)';
      card.style.zIndex = 10 - abs;
    });
    updateDots();
  }

  function syncMuteIcon(btn, muted) {
    btn.querySelector('.icon-muted').style.display  = muted ? '' : 'none';
    btn.querySelector('.icon-unmuted').style.display = muted ? 'none' : '';
  }

  function goTo(index) {
    const total = cards.length;
    const prev = cards[currentIndex]?.querySelector('video');
    if (prev) { prev.pause(); prev.currentTime = 0; }

    currentIndex = ((index % total) + total) % total;
    updateLayout();

    const centerVideo = cards[currentIndex]?.querySelector('video');
    if (centerVideo) {
      centerVideo.muted = true;
      centerVideo.play().catch(() => {});
      const btn = cards[currentIndex].querySelector('.vt-mute-btn');
      if (btn) syncMuteIcon(btn, true);
    }
    resetAutoplay();
  }

  function resetAutoplay() {
    clearInterval(autoplayTimer);
    const delay = {{ section.settings.autoplay_delay | default: 4000 }};
    if ({{ section.settings.autoplay | default: true }}) {
      autoplayTimer = setInterval(() => goTo(currentIndex + 1), delay);
    }
  }

  prevBtn?.addEventListener('click', () => goTo(currentIndex - 1));
  nextBtn?.addEventListener('click', () => goTo(currentIndex + 1));

  let touchStartX = 0;
  track.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  track.addEventListener('touchend', e => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) goTo(currentIndex + (diff > 0 ? 1 : -1));
  });

  cards.forEach((card, i) => {
    const btn = card.querySelector('.vt-mute-btn');
    const video = card.querySelector('video');
    if (btn && video) {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        video.muted = !video.muted;
        syncMuteIcon(btn, video.muted);
      });
    }
    card.addEventListener('click', () => { if (i !== currentIndex) goTo(i); });
  });

  buildDots();
  updateLayout();
  resetAutoplay();
  window.addEventListener('resize', updateLayout);
})();
</script>

{% schema %}
{
  "name": "Avis vidéo",
  "tag": "section",
  "class": "video-testimonials-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre de la section",
      "default": "What happimums have to say"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#2d2d2d"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur des étoiles",
      "default": "#f5a623"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Arrondi des cartes",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Défilement automatique",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "label": "Délai autoplay",
      "default": 4000
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacement haut",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacement bas",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Carte vidéo",
      "settings": [
        {
          "type": "text",
          "id": "video",
          "label": "URL vidéo MP4",
          "info": "Upload dans Contenu > Fichiers Shopify, puis colle l'URL ici"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image de remplacement"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label overlay (ex: The best maternity leggings 🤩)"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Note (étoiles)",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis vidéo",
      "blocks": [
        { "type": "video_card", "settings": { "rating": 5 } },
        { "type": "video_card", "settings": { "rating": 5 } },
        { "type": "video_card", "settings": { "rating": 4 } },
        { "type": "video_card", "settings": { "rating": 5 } },
        { "type": "video_card", "settings": { "rating": 4 } }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}