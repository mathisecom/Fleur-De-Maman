        },
        "166442457738b23caf-2": {
          "type": "item",
          "settings": {
            "title": "Aident-ils vraiment à soulager le dos ?",
            "content": "<p>Oui, ils répartissent le poids du ventre et réduisent la pression sur le bas du dos, apportant un réel confort au quotidien.</p>"
